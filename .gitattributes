# Data files are byte-exact: disable end-of-line conversion everywhere, so the
# SHA-256 values pinned in tests/evaluation_spec.json keep matching after a clone
# on any platform. Thirty input CSVs are deliberately CRLF; normalising them
# would break their hashes, so no *.csv rule exists below.
* -text

# Prose and the index are normalised to LF; nothing hashes them.
*.md    text=auto eol=lf
*.jsonl text=auto eol=lf
*.cff   text=auto eol=lf
*.sh    text=auto eol=lf
benchmark/metadata/tasks.csv text=auto eol=lf
.gitignore     text=auto eol=lf
.gitattributes text=auto eol=lf

# The two AlphaFold3 target-MSA caches total ~56 MB and ship as plain binaries,
# so a bare clone is enough to score the antibody-design tasks.
benchmark/tasks/_packages/assets/** -text -diff linguist-vendored
